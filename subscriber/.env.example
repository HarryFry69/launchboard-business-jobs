# Set on the PRIVATE hosted service, NOT in source control or browser JS.
APP_ORIGIN=https://your-private-launchboard.example
ACCESS_EMAIL=josh@example.com
# Generate these values with: cd subscriber && npm run hash-password
ACCESS_PASSWORD_HASH=scrypt:REPLACE_WITH_GENERATED_SALT:REPLACE_WITH_GENERATED_DIGEST
SESSION_SECRET=REPLACE_WITH_LONG_CRYPTOGRAPHIC_RANDOM_SECRET
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_STRIPE_TEST_KEY
# Recurring GBP 20/month price ID, NOT a payment link or product ID.
STRIPE_PRICE_ID=price_REPLACE_WITH_RECURRING_MONTHLY_PRICE
PORT=3000
